##############################################################################
# Kankotri Studio — environment configuration
#
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# The app runs fully in FREE "mock" mode with the defaults below — no API
# key or paid service required — so you can develop and demo at zero cost.
##############################################################################

# ---- Core ------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# ---- Database --------------------------------------------------------------
# Dev default is a local SQLite file. For production, switch the datasource
# provider in prisma/schema.prisma to "postgresql" and use a Postgres URL:
#   DATABASE_URL="postgresql://user:pass@host:5432/kankotri?sslmode=require"
DATABASE_URL="file:./dev.db"

# ---- Security --------------------------------------------------------------
# REQUIRED IN PRODUCTION. Must be at least 32 characters of high entropy.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=""

# ---- Image generation engine ----------------------------------------------
# "mock"   -> free, deterministic local compositing. Great for dev/tests/demos.
# "gemini" -> real Gemini 2.5 Flash Image ("Nano Banana"). Requires a key.
IMAGE_PROVIDER=mock

# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# NOTE: this is DIFFERENT from a consumer Gemini/Google-AI "Pro" subscription.
# The Pro chat plan does NOT grant API access; the API is billed separately
# (there is a free tier, then ~US$0.039 per generated image).
GEMINI_API_KEY=""
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- Spend & usage guardrails ---------------------------------------------
# Hard cap enforced INSIDE the app. Once estimated spend reaches this, the app
# refuses further paid generations (mock mode still works). Also set a matching
# budget cap in Google Cloud Billing as a second line of defence.
SPEND_LIMIT_USD=10

# Free generations included per organization per month.
FREE_MONTHLY_CREDITS=30

# ---- Uploads & storage -----------------------------------------------------
MAX_UPLOAD_MB=12
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage

# ---- Rate limiting ---------------------------------------------------------
# Requests allowed per IP per window for sensitive endpoints (auth, generate).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_GENERATE=20

# ---- Stripe billing (optional) --------------------------------------------
# Leave blank to keep the app on the free plan only. See docs/BILLING.md.
# Secret key from https://dashboard.stripe.com/apikeys (use a test key first).
STRIPE_SECRET_KEY=""
# Signing secret for your webhook endpoint (whsec_...), from the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=""
# Stripe Price ids (price_...) for each paid plan's recurring price.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_STUDIO=""

# ---- Super admin -----------------------------------------------------------
# Comma-separated emails allowed into /admin. Requires server config (not just a
# DB flag), so it can't be self-granted. Example: you@yourshop.com,ops@yourshop.com
SUPER_ADMIN_EMAILS=""
